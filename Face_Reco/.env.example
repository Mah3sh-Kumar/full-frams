# FRAMS Desktop Application - Environment Configuration
# Copy this file to .env and fill in your actual values

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# Application Settings
APP_NAME=FRAMS
DEBUG_MODE=False

# Camera Settings
CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# Face Recognition Settings
FACE_DETECTION_CONFIDENCE=0.5
FACE_RECOGNITION_THRESHOLD=0.6

# Notes:
# - Get SUPABASE_URL and SUPABASE_KEY from your Supabase project settings
# - CAMERA_INDEX: 0 for default camera, 1 for external camera
# - FACE_DETECTION_CONFIDENCE: 0.0-1.0 (higher = stricter detection)
# - FACE_RECOGNITION_THRESHOLD: 0.0-1.0 (lower = stricter matching)
